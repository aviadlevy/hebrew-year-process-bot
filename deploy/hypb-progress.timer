[Unit]
Description=Daily Hebrew year progress post

[Timer]
# The host runs in Etc/UTC, so this is the same instant as the GitHub Actions
# cron it replaces ('0 7 * * *', also UTC): the migration changes where the job
# runs, never when. To move it, do NOT edit this file --
#   sudo systemctl edit hypb-progress.timer
# and set OnCalendar in the drop-in, which survives reinstalling this unit.
# Jerusalem-local is one line: OnCalendar=*-*-* 07:00:00 Asia/Jerusalem
OnCalendar=*-*-* 07:00:00
# Catch up a run missed while the host was down, rather than skipping the day.
Persistent=true

[Install]
WantedBy=timers.target
