# Copy to /opt/hypb/progress.env on the host, fill in real values, then:
#   sudo chown root:root /opt/hypb/progress.env && sudo chmod 600 /opt/hypb/progress.env
# NEVER commit the filled-in file.
#
# These are ONLY the variables the daily progress post needs on top of the
# replier's. The four shared secrets stay in .env and are not repeated here, so
# the two files cannot drift apart. Both are passed to the container.

# Numeric account id of the bot on its Mastodon instance. Used to read the
# bot's own timeline when the state database has no row for a platform yet.
MASTODON_USER_ID=

# Twitter/X app credentials, from the project's Keys and tokens page.
CONSUMER_KEY=
CONSUMER_SECRET=
ACCESS_KEY=
ACCESS_SECRET=
