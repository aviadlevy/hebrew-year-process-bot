# Copy to /opt/hypb/.env on the host, fill in real values, then:
#   sudo chown root:root /opt/hypb/.env && sudo chmod 600 /opt/hypb/.env
# NEVER commit the filled-in file.

# Pinned release tag to run. Bump this to deploy; revert it to roll back.
# Must be a tag built AFTER multi-arch publishing landed on main — v3.1.2 and
# earlier are amd64-only and will NOT run on this ARM host.
IMAGE_TAG=

# Mastodon application access token and instance URL
MASTODON_ACCESS_TOKEN=
MASTODON_BASE_URL=https://mastodon.social

# Telegram bot token and chat id used for failure alerts
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. Log verbosity for `docker logs` (DEBUG, INFO, WARNING, ERROR).
# INFO logs every mention and every reply. Unset means INFO.
LOG_LEVEL=INFO

# Optional. A mention older than this many minutes is reported to Telegram but
# not answered, so a long outage does not end with replies nobody is waiting for.
# Unset means 30.
MENTION_MAX_AGE_MINUTES=30

# Optional. How often, in seconds, the replier asks Mastodon for new mentions;
# the longest anyone waits for an answer. Unset means 30.
POLL_INTERVAL_SECONDS=30
